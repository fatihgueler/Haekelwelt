@page "/"
@rendermode InteractiveServer
@inject ProductService ProductService
@inject WishlistService WishlistService

<PageTitle>Häkelwelt – Handgehäkeltes mit Liebe</PageTitle>

<section class="hero">
    <div class="container hero-grid">
        <div>
            <span class="tagline">Handgehäkelt mit Liebe</span>
            <h1>Kleine Schätze, die deinen Alltag wärmer machen.</h1>
            <p class="lead">
                Jedes Stück entsteht in unserer kleinen Werkstatt – Masche für Masche, mit
                ausgewählten Wollen und einem Auge fürs Detail. Wir versenden klimaneutral aus
                Deutschland, in Europa zuhause.
            </p>
            <div class="cta-row">
                <a href="/produkte" class="btn btn-primary">Zur Kollektion</a>
                <a href="/ueber-uns" class="btn btn-outline">Unsere Geschichte</a>
            </div>
        </div>
        <div class="hero-image">
            @if (_featured.FirstOrDefault()?.Images.FirstOrDefault() is { } hero)
            {
                <img src="@hero.Url" alt="@hero.Alt" />
            }
        </div>
    </div>
</section>

<section class="container features">
    <div class="feature"><h3>Mit Liebe gefertigt</h3><p>Handarbeit, keine Serie.</p></div>
    <div class="feature"><h3>Naturmaterialien</h3><p>OEKO-TEX-Wolle und Baumwolle.</p></div>
    <div class="feature"><h3>Gratisversand ab 50 €</h3><p>Plastikfrei verpackt mit DHL.</p></div>
</section>

<section class="band">
    <div class="container">
        <header class="section-header">
            <span class="tagline">Kategorien</span>
            <h2>Stöbere durch unsere Welten</h2>
        </header>
        <div class="category-grid">
            @foreach (var cat in _categories)
            {
                <a href="@($"/kategorie/{cat.Slug}")" class="category-card">
                    <h3>@cat.Name</h3>
                    @if (!string.IsNullOrEmpty(cat.Description))
                    {
                        <p>@cat.Description</p>
                    }
                    <span class="link">Entdecken →</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="container">
    <header class="section-header section-header-row">
        <div>
            <span class="tagline">Neu im Shop</span>
            <h2>Frisch eingetroffen</h2>
        </div>
        <a href="/produkte" class="link">Alle Produkte →</a>
    </header>
    <div class="product-grid">
        @foreach (var p in _featured)
        {
            <ProductCard Product="p" InitialInWishlist="_wishlist.Contains(p.Id)" />
        }
    </div>
</section>

@code {
    private List<Product> _featured = new();
    private List<Category> _categories = new();
    private HashSet<string> _wishlist = new();

    protected override async Task OnInitializedAsync()
    {
        _featured = await ProductService.ListFeaturedAsync(8);
        _categories = await ProductService.ListCategoriesAsync();
        _wishlist = await WishlistService.GetProductIdsAsync();
    }
}
