@page "/versand"

<PageTitle>Versand & Lieferung · Häkelwelt</PageTitle>

<div class="container page-pad narrow">
    <header class="section-header">
        <span class="tagline">Service</span>
        <h1>Versand & Lieferung</h1>
    </header>
    <article class="prose">
        <h2>Versandkosten</h2>
        <ul>
            <li>Deutschland: <strong>4,90 €</strong> pauschal, ab <strong>50 €</strong> versandkostenfrei.</li>
            <li>Andere EU-Länder: <strong>9,90 €</strong> pauschal, ab <strong>80 €</strong> versandkostenfrei.</li>
            <li>Außerhalb der EU: aktuell kein Versand.</li>
        </ul>

        <h2>Lieferzeiten</h2>
        <ul>
            <li>Deutschland: 2–4 Werktage.</li>
            <li>EU-Länder: 4–8 Werktage.</li>
        </ul>

        <h2>Verpackung</h2>
        <p>Plastikfrei: Karton, Pergaminpapier, kompostierbares Füllmaterial. Mit handgeschriebener Karte.</p>
    </article>
</div>
