@page "/admin/produkte"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@inject ProductService ProductService
@inject CategoryService CategoryService

<PageTitle>Produkte · Admin · Häkelwelt</PageTitle>

<div class="container page-pad">
    <header class="section-header section-header-row">
        <div>
            <a href="/admin" class="tagline">← Admin-Übersicht</a>
            <h1>Produkte</h1>
            <p class="muted">@(_products.Count == 0 ? "Noch keine Produkte angelegt." : $"{_products.Count} Produkt(e).")</p>
        </div>
        @if (_hasCategories)
        {
            <a href="/admin/produkte/neu" class="btn btn-primary">+ Neues Produkt</a>
        }
        else
        {
            <a href="/admin/kategorien/neu" class="btn btn-outline">Erst Kategorie anlegen</a>
        }
    </header>

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "alert alert-error" : "alert alert-success")">@_message</div>
    }

    @if (!_hasCategories)
    {
        <div class="empty-state">
            <p>Du brauchst mindestens eine Kategorie, bevor du Produkte anlegen kannst.</p>
        </div>
    }
    else if (_products.Count == 0)
    {
        <div class="empty-state">
            <p>Noch keine Produkte. Klick oben rechts auf „+ Neues Produkt".</p>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th></th>
                    <th>Titel</th>
                    <th>Kategorie</th>
                    <th>Preis</th>
                    <th>Bestand</th>
                    <th>Aktiv</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _products)
                {
                    <tr>
                        <td>
                            @if (p.Images.FirstOrDefault() is { } img)
                            {
                                <img src="@img.Url" alt="@img.Alt" class="admin-thumb" />
                            }
                        </td>
                        <td>
                            <strong>@p.Title</strong><br />
                            <code class="muted small">@p.Slug</code>
                        </td>
                        <td>@p.Category.Name</td>
                        <td>@PricingService.FormatPrice(p.PriceCents)</td>
                        <td>@p.Stock</td>
                        <td>@(p.IsActive ? "✓" : "—")</td>
                        <td class="row-actions">
                            <a href="@($"/admin/produkte/{p.Id}/bearbeiten")" class="btn btn-sm btn-outline">Bearbeiten</a>
                            <button class="btn btn-sm link-destructive" @onclick="() => Delete(p.Id)" disabled="@_pending">Löschen</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Product> _products = new();
    private bool _hasCategories;
    private bool _pending;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _products = await ProductService.ListAllForAdminAsync();
        _hasCategories = (await CategoryService.ListAllAsync()).Count > 0;
    }

    private async Task Delete(string id)
    {
        _pending = true;
        _message = null;
        try
        {
            await ProductService.DeleteAsync(id);
            _message = "Produkt entfernt (oder deaktiviert, falls bereits Bestellungen vorhanden).";
            _messageIsError = false;
            await Load();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _pending = false;
        }
    }
}
